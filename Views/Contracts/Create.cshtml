@model Contract
@{ ViewData["Title"] = "Create contract"; }
<div class="page-head"><div><div class="eyebrow">Agreement hub</div><h1>Create contract</h1><p class="muted">Add an agreement and upload its signed PDF.</p></div></div>
<div class="form-card"><form asp-action="Create" method="post" enctype="multipart/form-data"><div asp-validation-summary="ModelOnly"></div>
    <div class="field"><label asp-for="ClientId"></label><select asp-for="ClientId" asp-items="ViewBag.Clients"><option value="">Choose a client</option></select><span asp-validation-for="ClientId" class="validation"></span></div>
    <div class="field"><label asp-for="ServiceLevel"></label><input asp-for="ServiceLevel" placeholder="e.g. Express freight · 48-hour delivery" /><span asp-validation-for="ServiceLevel" class="validation"></span></div>
    <div class="field"><label asp-for="StartDate"></label><input asp-for="StartDate" /><span asp-validation-for="StartDate" class="validation"></span></div>
    <div class="field"><label asp-for="EndDate"></label><input asp-for="EndDate" /><span asp-validation-for="EndDate" class="validation"></span></div>
    <div class="field"><label asp-for="Status"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<ContractStatus>()"></select><span asp-validation-for="Status" class="validation"></span></div>
    <div class="field"><label for="agreement">Signed agreement (PDF)</label><input id="agreement" name="agreement" type="file" accept="application/pdf,.pdf" required /><div class="field-hint">PDF only, maximum 20 MB. The document is stored privately.</div><span class="validation">@Html.ValidationMessage("agreement")</span></div>
    <div class="form-actions"><button class="button" type="submit">Save contract</button><a class="button secondary" asp-action="Index">Cancel</a></div>
</form></div>
