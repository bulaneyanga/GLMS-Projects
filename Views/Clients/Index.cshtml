@model IEnumerable<Client>
@{ ViewData["Title"] = "Clients"; }
<div class="page-head"><div><div class="eyebrow">Customer directory</div><h1>Clients</h1><p class="muted">Manage organizations and regional contact details.</p></div><a class="button" asp-action="Create">Add client</a></div>
<div class="panel"><div class="panel-head"><h2>Client records</h2><span class="muted">@Model.Count() total</span></div><div class="table-wrap"><table><thead><tr><th>Name</th><th>Contact details</th><th>Region</th><th></th></tr></thead><tbody>
@foreach (var client in Model) { <tr><td><strong>@client.Name</strong></td><td>@client.ContactDetails</td><td>@client.Region</td><td><a asp-action="Edit" asp-route-id="@client.Id">Edit</a></td></tr> }
@if (!Model.Any()) { <tr><td colspan="4" class="empty">No clients yet. Add a client to get started.</td></tr> }
</tbody></table></div></div>
